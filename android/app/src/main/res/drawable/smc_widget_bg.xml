<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background. Rounded corners are required by the Android 12+ widget
     host, which clips to a rounded outline regardless of what we draw. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E60B1220" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="#33B9A279" />
</shape>