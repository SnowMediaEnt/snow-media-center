<?xml version="1.0" encoding="utf-8"?>
<!-- minWidth/minHeight are sized for a 4x2 launcher cell (70dp per cell - 30dp).
     updatePeriodMillis is clamped by the OS to 30 minutes minimum; the feed is
     news, so that cadence is plenty and costs no battery/bandwidth beyond it. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/smc_news_widget"
    android:previewImage="@mipmap/ic_launcher"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />